diff --git a/Projects/NUCLEO-F401RE/Applications/Contiki-NG/S2915A1_UDP_Server/Src/udp-server.c b/Projects/NUCLEO-F401RE/Applications/Contiki-NG/S2915A1_UDP_Server/Src/udp-server.c
index d71ed33..8625d59 100644
--- a/Projects/NUCLEO-F401RE/Applications/Contiki-NG/S2915A1_UDP_Server/Src/udp-server.c
+++ b/Projects/NUCLEO-F401RE/Applications/Contiki-NG/S2915A1_UDP_Server/Src/udp-server.c
@@ -53,7 +53,126 @@
 static struct simple_udp_connection udp_conn;
 
 PROCESS(udp_server_process, "UDP server");
+
+/* ---- RIG: MAC_GEN, a link-layer traffic generator -------------------------
+ *
+ * The coordinator's job in this rig is to give the victim something to decrypt,
+ * at a steady rate, so the passive listener has frames to time.  Stock
+ * Contiki-NG sends far too little: the UDP client reports every 5 s, which is
+ * ~0.2 secured frames/s where the attack needs tens per second.
+ *
+ * This is the ONE node that is deliberately not stock -- it is the traffic
+ * source, not the target, so nothing here has to be defended as realistic
+ * firmware.  What DOES have to be defended is the traffic SHAPE, because a
+ * passive attacker cannot make a device transmit: a 24-byte payload every
+ * 20 ms is a "device reports periodically" model, and 24 bytes is the measured
+ * optimum for a passive listener (it beat both 16 and 48; see
+ * PASSIVE_ORACLE.md RESULT 5d).  Do not tune it further to flatter the attack.
+ */
+#if MAC_GEN
+#include "net/netstack.h"
+#include "net/packetbuf.h"
+#include "net/linkaddr.h"
+#include "net/mac/mac.h"
+#include <string.h>
+
+/* Destination EUI-64, as linkaddr_t stores it (MSB first).  With NODE_MAC_FIXED
+ * on both nodes this is a compile-time constant and the coordinator needs to
+ * know nothing about the victim at run time. */
+#ifndef MAC_GEN_DST
+#define MAC_GEN_DST 0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x02
+#endif
+#ifndef MAC_GEN_INTERVAL_MS
+#define MAC_GEN_INTERVAL_MS 20
+#endif
+#ifndef MAC_GEN_PAYLOAD
+#define MAC_GEN_PAYLOAD 24
+#endif
+/* Randomise payload bytes 16.. on every frame, keeping the FIRST 16 fixed.
+ * This is the realism control: a wholly constant payload makes the CBC-MAC
+ * blocks over it identical frame to frame, contributing a constant instead of
+ * variance, while randomising ALL of it would destroy the known plaintext the
+ * output-side attack needs.  Real 6LoWPAN/UDP traffic is predictable in its
+ * leading header bytes and variable after, which is what this reproduces.
+ * Measured to cost nothing (identical robust sd), so it is safe to leave on. */
+#ifndef MAC_GEN_RANDTAIL
+#define MAC_GEN_RANDTAIL 0
+#endif
+
+PROCESS(mac_gen_process, "MAC traffic generator");
+
+static void
+mac_gen_sent(void *ptr, int status, int num_tx)
+{
+  (void)ptr; (void)status; (void)num_tx;
+}
+
+PROCESS_THREAD(mac_gen_process, ev, data)
+{
+  static struct etimer et;
+  static linkaddr_t dst = { { MAC_GEN_DST } };   /* comma list, see NODE_MAC_FIXED */
+  static uint8_t payload[MAC_GEN_PAYLOAD];
+  unsigned i;
+
+  PROCESS_BEGIN();
+  printf("MAC_GEN: %d-byte payload (randtail=%d) every %d ms to ",
+         (int)MAC_GEN_PAYLOAD, (int)MAC_GEN_RANDTAIL, (int)MAC_GEN_INTERVAL_MS);
+  for(i = 0; i < LINKADDR_SIZE; i++) {
+    printf("%02x", dst.u8[i]);
+  }
+  printf("\n");
+
+  for(i = 0; i < MAC_GEN_PAYLOAD; i++) {
+    payload[i] = (uint8_t)(0x40 + (i & 0x0f));
+  }
+
+  etimer_set(&et, (MAC_GEN_INTERVAL_MS * CLOCK_SECOND) / 1000);
+  while(1) {
+    PROCESS_WAIT_EVENT_UNTIL(etimer_expired(&et));
+    etimer_reset(&et);
+
+#if MAC_GEN_RANDTAIL
+    {
+      static uint32_t st = 0x12345678u;
+      for(i = 16; i < MAC_GEN_PAYLOAD; i++) {
+        st ^= st << 13; st ^= st >> 17; st ^= st << 5;
+        payload[i] = (uint8_t)st;
+      }
+    }
+#endif
+    packetbuf_clear();
+    memcpy(packetbuf_dataptr(), payload, MAC_GEN_PAYLOAD);
+    packetbuf_set_datalen(MAC_GEN_PAYLOAD);
+    packetbuf_set_addr(PACKETBUF_ADDR_RECEIVER, &dst);
+    /* MUST be set explicitly.  packetbuf_clear() memsets the attributes to 0,
+     * but csma.c init_sec() only applies CSMA_LLSEC_SECURITY_LEVEL when it
+     * finds the sentinel PACKETBUF_ATTR_SECURITY_LEVEL_DEFAULT (0xffff) -- so a
+     * zeroed attribute means level 0 and the frame goes out IN PLAINTEXT with
+     * no AES anywhere in the victim's receive path.  An earlier version of this
+     * generator hit exactly that and captured 30000 records containing no
+     * cipher at all.  Set MAC_GEN_UNSECURED=1 to get it back deliberately, as
+     * a no-AES control arm at matched frame length. */
+#if MAC_GEN_UNSECURED
+    packetbuf_set_attr(PACKETBUF_ATTR_SECURITY_LEVEL, 0);
+#else
+    packetbuf_set_attr(PACKETBUF_ATTR_SECURITY_LEVEL,
+                       PACKETBUF_ATTR_SECURITY_LEVEL_DEFAULT);
+#endif
+    /* Unicast plus this attribute is what makes framer-802154.c set
+     * fcf.ack_required, which is what makes the victim ACK -- and the ACK is
+     * the entire oracle. */
+    packetbuf_set_attr(PACKETBUF_ATTR_MAC_ACK, 1);
+    NETSTACK_MAC.send(mac_gen_sent, NULL);
+  }
+  PROCESS_END();
+}
+#endif /*MAC_GEN*/
+
+#if MAC_GEN
+AUTOSTART_PROCESSES(&udp_server_process, &mac_gen_process);
+#else
 AUTOSTART_PROCESSES(&udp_server_process);
+#endif
