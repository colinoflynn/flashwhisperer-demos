+#ifdef PORT_GATE_TRACE
+/* Declared WELL ABOVE ST's section attribute, and the gap matters.
+ * The attributes below -- section(".SE_CallGate_Code") and
+ * optimize("O0") -- apply to the NEXT declaration in the file.  An
+ * earlier version of this patch put this extern between them and
+ * SE_CallGate, which silently moved the call gate out of its region
+ * and put PORT_Trace there instead: the region then held four bytes
+ * of linker padding, and the first SE call executed it as an
+ * instruction.  The fault was an UNDEFINSTR at 0x08000204. */
+extern void PORT_Trace(const char *tag, uint32_t a, uint32_t b);
+#endif /* PORT_GATE_TRACE */
