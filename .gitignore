# Firmware build output. Every demo's victim builds out of tree.
Build/
build/

# Fetched dependencies. deps/PINS is the authority on what each one is.
# deps/ethtimer is a gitlink, deps/flashwhisperer is a vendored subtree whose
# files ARE tracked (deps/README.md says why, and why that is temporary), and
# everything else a fetch puts here is ignored rather than half-tracked.
deps/*
!deps/PINS
!deps/README.md
!deps/fetch.sh
!deps/flashwhisperer
!deps/ethtimer

# Raw captures. The vectors under demos/*/vectors/ ARE tracked and are small
# on purpose; captures/MANIFEST.tsv records a size and a SHA-256 for the big
# files that stay on the bench.
captures/**/*.npz
captures/**/*.npy
captures/**/*.log

# A board map is per-machine: probe serials, ports, which board is plugged in.
BOARDS.local.json

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
